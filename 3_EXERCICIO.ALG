Algoritmo "3_Exercicio"

Var

   base, altura, area, per: real


Inicio

    escreva("entre com a base do triângulo: ")
    leia(base)
    escreva("entre com a altura do triângulo: ")
    leia(altura)
    area <- (base*altura) / 2
    escreva("a área do triângulo é de: ", area)
    perimetro <- 2* (base+altura)
    escreva("o perimetro do triângulo é de: ", perimetro)



Fimalgoritmo